<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_autenticacion"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tutoriamovil2.Login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_a_registroCorreo"
            app:destination="@id/registroCorreoFragment" />
    </fragment>
    <fragment
        android:id="@+id/completarPerfilFragment"
        android:name="com.example.tutoriamovil2.Login.CompletarPerfilFragment"
        android:label="fragment_completar_perfil"
        tools:layout="@layout/fragment_completar_perfil" />
    <fragment
        android:id="@+id/registroCorreoFragment"
        android:name="com.example.tutoriamovil2.Login.RegistroCorreoFragment"
        android:label="fragment_registro_correo"
        tools:layout="@layout/fragment_registro_correo">
        <action
            android:id="@+id/action_registroCorreo_a_registroCodigo"
            app:destination="@id/registroCodigoFragment" />
    </fragment>
    <fragment
        android:id="@+id/registroCodigoFragment"
        android:name="com.example.tutoriamovil2.Login.RegistroCodigoFragment"
        android:label="fragment_registro_codigo"
        tools:layout="@layout/fragment_registro_codigo">
        <action
            android:id="@+id/action_registroCodigo_a_completarPerfil"
            app:destination="@id/completarPerfilFragment" />
    </fragment>
</navigation>
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa 1: El borde (Crea un rectángulo del color del borde) -->
    <item>
        <shape android:shape="rectangle">
            <!-- Cambia este color por el que quieras para tu borde -->
            <solid android:color="@color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Capa 2: El fondo del contenedor (Se encima dejando ver solo el borde) -->
    <!-- El "android:inset" debe ser igual al grosor que desees para tu borde (ej. 2dp) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <!-- Mantiene tu color de fondo original -->
            <solid android:color="@color/primary" />
            <!-- El radio debe ser un poco menor o igual al de la capa 1 -->
            <corners android:radius="10dp" />
        </shape>
    </item>

</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colores principales de la app -->
    <color name="primary">#0F2D71</color>        <!-- Azul institucional UNICAH -->
    <color name="primary_dark">#0A1E4A</color>   <!-- Azul más oscuro para estados -->
    <color name="accent">#F59E0B</color>         <!-- Amarillo/Naranja de acento (ej. botones de confirmación) -->

    <!-- Textos y fondos -->
    <color name="ink">#1F2937</color>            <!-- Color principal para títulos y textos oscuros -->
    <color name="grey">#6B7280</color>           <!-- Gris secundario para subtítulos -->
    <color name="background">#F4F4F6</color>     <!-- Gris claro para el fondo general de las vistas -->
    <color name="white">#FFFFFF</color>

    <!-- Estados y alertas -->
    <color name="error">#DC2626</color>          <!-- Rojo para errores o botones de cancelar/inasistencia -->
    <color name="success">#16A34A</color>        <!-- Verde para estados finalizados con éxito -->

    <!-- Botones, campos y chips -->
    <color name="btn_primary_bg">#0F2D71</color>
    <color name="line">#E5E7EB</color>
    <color name="input_stroke">#D1D5DB</color>
    <color name="chip_bg">#F4F4F6</color>
    <color name="chip_text">#1F2937</color>
    <color name="chip_stroke">#D1D5DB</color>

    <!-- Contenedores de estado (fondos claros) -->
    <color name="primary_container">#DCE3F5</color>
    <color name="success_container">#DCFCE7</color>
    <color name="error_container">#FEE2E2</color>
    <color name="warning_container">#FEF3C7</color>
    <color name="warning_text">#92400E</color>

    <!-- Selector de fecha -->
    <color name="date_bg">#FFFFFF</color>
    <color name="date_text">#1F2937</color>
    <color name="date_text_dim">#6B7280</color>
</resources>
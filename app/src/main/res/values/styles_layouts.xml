<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Botones -->
    <style name="Widget.TutorU.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:stateListAnimator">@animator/presion_suave</item>
    </style>
    <!-- Botón principal con degradado azul (login, registro, llamadas fuertes) -->
    <style name="Widget.TutorU.Button.Gradiente">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_boton_gradiente</item>
    </style>
    <!-- Acción que no se puede deshacer (cancelar una tutoría) -->
    <style name="Widget.TutorU.Button.Peligro">
        <item name="backgroundTint">@color/error</item>
    </style>
    <!-- Botón amarillo sobre fondos azules -->
    <style name="Widget.TutorU.Button.Sol">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_boton_sol</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Widget.TutorU.ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:stateListAnimator">@animator/presion_suave</item>
    </style>
    <style name="Widget.TutorU.ButtonAccent" parent="Widget.TutorU.Button">
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/accent</item>
    </style>
    <style name="Widget.TutorU.ButtonSmall" parent="Widget.TutorU.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TutorU.ButtonSmallOutlined" parent="Widget.TutorU.ButtonOutlined">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TutorU.ButtonSmallDanger" parent="Widget.TutorU.ButtonSmallOutlined">
        <item name="android:textColor">@color/error</item>
        <item name="strokeColor">@color/error</item>
    </style>

    <!-- Campos -->
    <style name="Widget.TutorU.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/sel_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="startIconTint">@color/grey</item>
        <item name="endIconTint">@color/grey</item>
        <item name="hintEnabled">false</item>
    </style>
    <style name="Widget.TutorU.Input.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/sel_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="startIconTint">@color/grey</item>
        <item name="endIconTint">@color/grey</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Tarjeta, chip y pestañas tipo segmentado -->
    <style name="Widget.TutorU.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/presion_suave</item>
    </style>
    <style name="ShapeAppearance.TutorU.Chip" parent="">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.TutorU.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/sel_chip_bg</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="chipStrokeColor">@color/sel_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/sel_chip_text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TutorU.Chip</item>
    </style>
    <style name="Widget.TutorU.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_segmented</item>
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabTextColor">@color/grey</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
    </style>
    <!-- Barra de navegación inferior -->
    <style name="Widget.TutorU.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_nav_inferior</item>
        <item name="android:outlineSpotShadowColor">@color/primary</item>
        <item name="android:outlineAmbientShadowColor">@color/primary</item>
        <item name="itemIconTint">@color/sel_nav_text</item>
        <item name="itemTextColor">@color/sel_nav_text</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemActiveIndicatorStyle">@style/TutorU.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TutorU.NavTexto.Activo</item>
        <item name="itemTextAppearanceInactive">@style/TutorU.NavTexto</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">18dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="itemRippleColor">@color/primary_container</item>
        <!-- La actividad ya deja el espacio de la barra del sistema. -->
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
    <style name="TutorU.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_container</item>
        <item name="android:width">60dp</item>
        <item name="android:height">32dp</item>
    </style>
    <style name="TutorU.NavTexto" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TutorU.NavTexto.Activo">
        <item name="android:textStyle">bold</item>
    </style>


    <!-- Encabezado azul de las pantallas (igual que Inicio y Perfil) -->
    <style name="TutorU.Encabezado" parent="">
        <item name="android:background">@drawable/bg_header_inicio</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">40dp</item>
    </style>
    <!-- Encabezado sin contenido montado encima -->
    <style name="TutorU.Encabezado.Corto">
        <item name="android:paddingBottom">24dp</item>
    </style>
    <style name="TutorU.Encabezado.Titulo" parent="">
        <item name="android:fontFamily">@font/jakarta_titulo</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TutorU.Encabezado.Subtitulo" parent="">
        <item name="android:textColor">@color/texto_sobre_azul</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <!-- Botón redondo translúcido para usar sobre azul (atrás, campana) -->
    <style name="TutorU.BotonVidrio" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_boton_vidrio</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/white</item>
    </style>
    <!-- Bloque de contenido que sube sobre el encabezado y entra por partes -->
    <style name="TutorU.Contenido" parent="">
        <item name="android:layout_marginTop">-24dp</item>
        <item name="android:layoutAnimation">@anim/layout_entrada</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
    </style>
    <!-- Título de sección con una barrita amarilla (usar con drawableStart) -->
    <style name="TutorU.Seccion" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableStart">@drawable/barra_seccion</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <!-- Caja de búsqueda blanca con sombra suave -->
    <style name="Widget.TutorU.Card.Flotante">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Textos, insignias y campos de las pantallas de administración -->
    <style name="Tu.Heading" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Tu.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Tu.Badge" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_pill_blue</item>
    </style>
    <style name="Tu.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>
</resources>

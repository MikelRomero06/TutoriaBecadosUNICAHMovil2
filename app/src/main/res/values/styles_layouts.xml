<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Botones -->
    <style name="Widget.TutorU.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TutorU.ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TutorU.ButtonAccent" parent="Widget.TutorU.Button">
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/accent</item>
    </style>
    <style name="Widget.TutorU.ButtonSmall" parent="Widget.TutorU.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Widget.TutorU.ButtonSmallOutlined" parent="Widget.TutorU.ButtonOutlined">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Widget.TutorU.ButtonSmallDanger" parent="Widget.TutorU.ButtonSmallOutlined">
        <item name="android:textColor">@color/error</item>
        <item name="strokeColor">@color/error</item>
    </style>

    <!-- Campos -->
    <style name="Widget.TutorU.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
    </style>
    <style name="Widget.TutorU.Input.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Tarjeta, chip y pestañas tipo segmentado -->
    <style name="Widget.TutorU.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="ShapeAppearance.TutorU.Chip" parent="">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.TutorU.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/sel_chip_bg</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="chipStrokeColor">@color/sel_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/sel_chip_text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TutorU.Chip</item>
    </style>
    <style name="Widget.TutorU.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_segmented</item>
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabTextColor">@color/grey</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
    </style>
    <!-- Barra de navegación inferior -->
    <style name="Widget.TutorU.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="itemIconTint">@color/sel_nav_text</item>
        <item name="itemTextColor">@color/sel_nav_text</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemActiveIndicatorStyle">@style/TutorU.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TutorU.NavTexto.Activo</item>
        <item name="itemTextAppearanceInactive">@style/TutorU.NavTexto</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
        <!-- La actividad ya deja el espacio de la barra del sistema. -->
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
    <style name="TutorU.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>
    <style name="TutorU.NavTexto" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TutorU.NavTexto.Activo">
        <item name="android:textStyle">bold</item>
    </style>


    <!-- Textos, insignias y campos de las pantallas de administración -->
    <style name="Tu.Heading" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Tu.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Tu.Badge" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_pill_blue</item>
    </style>
    <style name="Tu.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>
</resources>

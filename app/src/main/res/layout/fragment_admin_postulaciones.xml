<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTENEDOR CON SCROLL GLOBAL PARA TODA LA PANTALLA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Barra superior con botón Volver y Título -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_back" />

                <TextView
                    style="@style/Tu.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Aprobaciones"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Pestañas / Filtros Superiores (Fotos y Postulaciones) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button2"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_linear_border"
                        android:text="Fotos"
                        android:textAlignment="center"
                        android:textColor="@color/background"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/button"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_otp_box"
                        android:text="Postulaciones"
                        android:textAlignment="center"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Contenedor de las tarjetas con su respectivo padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="16dp">

                <!-- TARJETA 1: Postulación de María López -->
                <LinearLayout
                    android:id="@+id/cardApplication1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgApplicant1"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_avatar"
                            android:contentDescription="Foto de postulante"
                            android:src="@drawable/ic_person" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Tu.Heading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Postulación a tutor"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvApplicant1"
                                style="@style/Tu.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="María López · Ing. en Sistemas"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubjects1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Materias: Programación, Bases de datos"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Tu.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Verifica que sea becada antes de aprobar."
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etRejectReason1"
                        style="@style/Tu.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Motivo (obligatorio si rechazas)"
                        android:inputType="textCapSentences"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAprobar3"
                            style="@style/Widget.TutorU.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_linear_border"
                            android:text="Aprobar"
                            android:textColor="@color/background"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRejectPhoto2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_linear_border_red"
                            android:text="Rechazar"
                            android:textColor="@color/background"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:strokeColor="#DC2626"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- TARJETA 2: Postulación de Luis Pérez -->
                <LinearLayout
                    android:id="@+id/cardApplication2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgApplicant2"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_avatar"
                            android:contentDescription="Foto de postulante"
                            android:src="@drawable/ic_person" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Tu.Heading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Postulación a tutor"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvApplicant2"
                                style="@style/Tu.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Luis Pérez · Ing. Industrial"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubjects2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Materias: Estadística, Física"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Tu.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Verifica que sea becada antes de aprobar."
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etRejectReason2"
                        style="@style/Tu.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Motivo (obligatorio si rechazas)"
                        android:inputType="textCapSentences"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAprobar4"
                            style="@style/Widget.TutorU.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_linear_border"
                            android:text="Aprobar"
                            android:textColor="@color/background"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRejectPhoto3"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_linear_border_red"
                            android:text="Rechazar"
                            android:textColor="@color/background"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:strokeColor="#DC2626"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR DE ADMINISTRADOR (Fija en la parte inferior) -->
    <LinearLayout
        android:id="@+id/bottomNavAdmin"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Pestaña 1: Inicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAdminInicio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Inicio"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/inicio" />
        </LinearLayout>

        <!-- Pestaña 2: No realizadas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavNoRealizadas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/background"
                android:contentDescription="No realizadas"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/norealizadas" />
        </LinearLayout>

        <!-- Pestaña 3: Aprobaciones (Activa) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAprobaciones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Aprobaciones"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/aprobacionesazul" />
        </LinearLayout>

        <!-- Pestaña 4: Bitácora -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavBitacora"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Bitácora"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/bitacora" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
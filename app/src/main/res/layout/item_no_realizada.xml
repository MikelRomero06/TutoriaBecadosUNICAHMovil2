<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.TutorU.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/accent"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvFechaMateria"
                style="@style/Tu.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                tools:text="Vie 30/10 14:00 · Cálculo I"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/tvTipo"
                    style="@style/Tu.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_red"
                    android:textColor="@color/error"
                    tools:text="CANCELADA POR EL TUTOR"/>
                <TextView
                    android:id="@+id/tvRevision"
                    style="@style/Tu.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_amber"
                    android:textColor="@color/warning_text"
                    android:layout_marginStart="8dp"
                    tools:text="sin revisar"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvPartes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                tools:text="Tutor: Nombre - Estudiante: Nombre"/>
            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/grey"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Categoría: Enfermedad"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_info_suave"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvLblAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Motivo para Bienestar:"/>
                <TextView
                    android:id="@+id/tvMotivoAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    tools:text="Tengo un evento académico obligatorio"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_info_suave"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvLblContraparte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Motivo para el estudiante:"/>
                <TextView
                    android:id="@+id/tvMotivoContraparte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    tools:text="Me surgió un evento. ¿Lo pasamos al lunes?"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRevisado"
                style="@style/Widget.TutorU.ButtonSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Marcar revisado"
                android:layout_marginTop="14dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCitar"
                    style="@style/Widget.TutorU.ButtonSmallOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Citar"
                    android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistorial"
                    style="@style/Widget.TutorU.ButtonSmallOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Ver historial"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

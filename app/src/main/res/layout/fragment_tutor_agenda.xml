<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Encabezado azul -->
    <LinearLayout
        style="@style/TutorU.Encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/marca_blanca" />

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/TutorU.Encabezado.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agenda_titulo" />

        <TextView
            style="@style/TutorU.Encabezado.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Las tutorías que vas a dar." />
    </LinearLayout>

    <!-- Pestañas en una tarjeta que sube sobre el encabezado -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TutorU.Card.Flotante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-26dp"
        android:stateListAnimator="@null">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProximas"
                    style="@style/Widget.TutorU.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/agenda_proximas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHistorial"
                    style="@style/Widget.TutorU.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agenda_historial" />
            </com.google.android.material.chip.ChipGroup>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="20dp"
        android:textColor="@color/grey"
        android:textSize="13sp"
        tools:text="3 tutorías confirmadas" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAgenda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_agenda" />

    <LinearLayout
        android:id="@+id/grupoVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivVacio"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/magnuslibros" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/grey"
            android:textSize="14sp"
            tools:text="No tenés tutorías próximas." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccion"
            style="@style/Widget.TutorU.ButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/agenda_buscar_tutor" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressMas"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
</LinearLayout>

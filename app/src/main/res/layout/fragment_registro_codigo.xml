<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Encabezado azul -->
        <LinearLayout
            style="@style/TutorU.Encabezado.Corto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack2"
                    style="@style/TutorU.BotonVidrio"
                    android:contentDescription="Regresar"
                    android:src="@drawable/ic_back" />

                <TextView
                    style="@style/TutorU.Encabezado.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Verifica tu correo"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_sol"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Paso 2 de 3"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_entrada"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Escribe el código"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEnviadoA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Lo enviamos a tu correo. Vence en 15 min."
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <!-- Contenedor para los 6 dígitos del código -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Puedes replicar este EditText 6 veces o usar un componente OTP dedicado -->
            <EditText
                android:id="@+id/digito1"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/digito2"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/digito3"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/digito4"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/digito5"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/digito6"
                android:layout_width="48dp"
                android:layout_height="55dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIntentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReenviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Reenviar código en 0:42"
            android:textColor="@color/grey"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificar"
            style="@style/Widget.TutorU.Button.Gradiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="Verificar código" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirCorreo"
            style="@style/Widget.TutorU.ButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="Abrir correo" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
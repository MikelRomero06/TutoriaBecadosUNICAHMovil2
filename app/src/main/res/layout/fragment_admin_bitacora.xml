<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">
        <LinearLayout
            app:layout_scrollFlags="scroll"
            android:layout_marginBottom="-24dp"
            style="@style/TutorU.Encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp">
            <ImageButton
                android:id="@+id/btnBack"
                style="@style/TutorU.BotonVidrio"
                android:contentDescription="Volver"
                android:src="@drawable/ic_back"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    style="@style/TutorU.Encabezado.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bitácora"
                    android:textSize="22sp"/>
                <TextView
                    style="@style/TutorU.Encabezado.Subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lo que pasa en las tutorías"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TutorU.Card.Flotante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button2"
                        style="@style/Widget.TutorU.ButtonSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Requiere Atención"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button3"
                        style="@style/Widget.TutorU.ButtonSmallOutlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Fecha"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button"
                        style="@style/Widget.TutorU.ButtonSmallOutlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Usuario"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TutorU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cardLog1"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:id="@+id/tvTimestamp1"
                                    style="@style/Tu.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_blue"
                                    android:textColor="@color/primary"
                                    android:text="29/10 16:20"/>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/badgeAttention1"
                                style="@style/Tu.Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_red"
                                android:textColor="@color/error"
                                android:text="(!)"
                                android:contentDescription="Requiere atención"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvDescription1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:text="Dennis X canceló la tutoría #152. Motivo (admin): &quot;evento académico&quot;"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TutorU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cardLog2"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:id="@+id/tvTimestamp2"
                                    style="@style/Tu.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_blue"
                                    android:textColor="@color/primary"
                                    android:text="29/10 14:05"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvDescription2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:text="Juan Pérez reservó con Dennis X · Cálculo I · 30/10 14:00 · Presencial"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TutorU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cardLog3"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/primary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:id="@+id/tvTimestamp3"
                                    style="@style/Tu.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_blue"
                                    android:textColor="@color/primary"
                                    android:text="29/10 09:12"/>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/badgeAttention3"
                                style="@style/Tu.Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_red"
                                android:textColor="@color/error"
                                android:text="(!)"
                                android:contentDescription="Requiere atención"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvDescription3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:text="Nueva postulación a tutor: María López"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="32dp"
                android:background="@drawable/bg_info_suave"
                android:gravity="center"
                android:padding="24dp"
                android:text="Todavía no hay eventos registrados."
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:padding="32dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="center"
                    tools:text="No se pudo cargar la información."/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReintentar"
                    style="@style/Widget.TutorU.ButtonSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Reintentar"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="24dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

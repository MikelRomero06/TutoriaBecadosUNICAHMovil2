<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTENEDOR CON SCROLL GLOBAL PARA TODA LA PANTALLA -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Barra superior con botón Volver y Título -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_back" />

                <TextView
                    style="@style/Tu.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Bitácora"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Pestañas / Filtros Horizontales -->

            <!-- Contenedor de las tarjetas de registro -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal">

                    <!-- Chip Activo (Fotos) -->

                    <!-- Chip Inactivo (Postulaciones) -->

                    <Button
                        android:id="@+id/button2"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_linear_border"
                        android:text="Requiere Atención"
                        android:textAlignment="center"
                        android:textColor="@color/background"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/button3"
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_otp_box"
                        android:text="Fecha"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/button"
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_otp_box"
                        android:text="Usuario"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="12dp">

                <!-- TARJETA DE LOG 1 -->
                <LinearLayout
                    android:id="@+id/cardLog1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTimestamp1"
                            style="@style/Tu.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="29/10 16:20"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeAttention1"
                            style="@style/Tu.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:background="@drawable/bg_badge_red"
                            android:text="(!)"
                            android:textColor="@color/tu_red" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvDescription1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Dennis X canceló la tutoría #152. Motivo (admin): &quot;evento académico&quot;"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- TARJETA DE LOG 2 -->
                <LinearLayout
                    android:id="@+id/cardLog2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTimestamp2"
                            style="@style/Tu.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="29/10 14:05"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvDescription2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Juan Pérez reservó con Dennis X · Cálculo I · 30/10 14:00 · Presencial"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- TARJETA DE LOG 3 -->
                <LinearLayout
                    android:id="@+id/cardLog3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTimestamp3"
                            style="@style/Tu.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="29/10 09:12"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeAttention3"
                            style="@style/Tu.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:background="@drawable/bg_badge_red"
                            android:text="(!)"
                            android:textColor="@color/tu_red" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvDescription3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nueva postulación a tutor: María López"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavAdmin"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Pestaña 1: Inicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAdminInicio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Inicio"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/inicio" />

        </LinearLayout>

        <!-- Pestaña 2: No realizadas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavNoRealizadas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="No realizadas"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/norealizadas" />

        </LinearLayout>

        <!-- Pestaña 3: Aprobaciones (Activa) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAprobaciones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Aprobaciones"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/aprobaciones" />

        </LinearLayout>

        <!-- Pestaña 4: Bitácora -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavBitacora"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/background"
                android:contentDescription="Bitácora"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/bitcoraazul" />

        </LinearLayout>

    </LinearLayout>

    <!-- BARRA DE NAVEGACIÓN INFERIOR DE ADMINISTRADOR (Fija en la parte inferior) -->

</androidx.constraintlayout.widget.ConstraintLayout>
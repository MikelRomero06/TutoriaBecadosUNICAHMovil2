<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reportar inasistencia"
        android:textSize="20sp"
        android:textColor="@color/ink"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Por favor, especifica el motivo por el cual reportas que el tutor no asistió a la sesión."
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:layout_marginBottom="20dp"/>

    <!-- Campo de texto para el motivo -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TutorU.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMotivoInasistencia"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Escribe aquí el motivo detallado..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="4"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarReporte"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Volver"
            android:textColor="@color/grey"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarReporte"
            style="@style/Widget.TutorU.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enviar reporte"
            android:backgroundTint="@android:color/holo_red_dark"/>
    </LinearLayout>

</LinearLayout>
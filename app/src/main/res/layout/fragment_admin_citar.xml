<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">
    <LinearLayout
        style="@style/TutorU.Encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp">
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/TutorU.BotonVidrio"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                style="@style/TutorU.Encabezado.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nueva citación"
                android:textSize="22sp"/>
            <TextView
                style="@style/TutorU.Encabezado.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa los datos de la reunión"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-24dp"
        android:elevation="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TutorU.Card.Flotante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:id="@+id/tvCitacionContexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:background="@drawable/bg_info_suave"
                        android:padding="12dp"
                        android:textStyle="bold"
                        tools:text="Vie 30/10 14:00 · Cálculo I"/>
                    <TextView
                        style="@style/TutorU.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="¿A quién se cita?"/>
                    <RadioGroup
                        android:id="@+id/rgCitado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTutor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Tutor"
                            android:textColor="@color/ink"/>
                        <RadioButton
                            android:id="@+id/rbEstudiante"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Estudiante"
                            android:textColor="@color/ink"/>
                    </RadioGroup>
                    <TextView
                        style="@style/TutorU.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Motivo"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMotivo"
                        style="@style/Widget.TutorU.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMotivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Escribe el motivo de la citación"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:gravity="top|start"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        style="@style/TutorU.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Fecha y hora"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilFecha"
                                style="@style/Widget.TutorU.Input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFecha"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Fecha"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:cursorVisible="false"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="4dp">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilHora"
                                style="@style/Widget.TutorU.Input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etHora"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Hora"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:cursorVisible="false"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        style="@style/TutorU.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Lugar"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLugar"
                        style="@style/Widget.TutorU.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLugar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Aula u oficina"
                            android:inputType="textCapSentences"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <ProgressBar
                android:id="@+id/progressCitacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearCitacion"
                style="@style/Widget.TutorU.Button.Gradiente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:text="Crear citación"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.TutorU.ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:text="Cancelar"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

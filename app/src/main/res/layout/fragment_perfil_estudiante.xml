<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título superior -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi Perfil"
            android:textSize="24sp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Tarjeta de cabecera con Datos del Estudiante -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TutorU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <!-- Avatar de perfil -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_unicah"
                        android:contentDescription="Foto de perfil"/>
                </FrameLayout>

                <!-- Nombre del Estudiante -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textSize="18sp"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp"/>

                <!-- Correo institucional -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="jperez@unicah.edu"
                    android:textSize="13sp"
                    android:textColor="@color/grey"
                    android:layout_marginBottom="8dp"/>

                <!-- Badge de Rol -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estudiante"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_badge_paso"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Detalles Académicos -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TutorU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información académica"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Carrera -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Carrera" android:textColor="@color/grey" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ing. en Ciencias de la Computación" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Número de cuenta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Número de cuenta" android:textColor="@color/grey" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0101-2006-03776" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Teléfono -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Teléfono" android:textColor="@color/grey" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+504 9999-0000" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de Acción / Configuración -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarPerfil"
            style="@style/Widget.TutorU.ButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Cambiar foto de perfil" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.TutorU.ButtonSmallDanger"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cerrar sesión"
            app:strokeWidth="1dp"/>

    </LinearLayout>
</ScrollView>
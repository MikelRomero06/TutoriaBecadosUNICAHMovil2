<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar tutoría"
        android:textSize="20sp"
        android:textColor="@color/ink"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Indica el motivo de la cancelación. Esta acción notificará al tutor y quedará registrada."
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:layout_marginBottom="20dp"/>

    <!-- Campo de texto para el motivo de cancelación -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TutorU.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMotivoCancelacion"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Ej. Surgió un inconveniente de última hora..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="4"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverCancelacion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Regresar"
            android:textColor="@color/grey"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarCancelacion"
            style="@style/Widget.TutorU.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Confirmar cancelación"
            android:backgroundTint="@android:color/holo_red_dark"/>
    </LinearLayout>

</LinearLayout>
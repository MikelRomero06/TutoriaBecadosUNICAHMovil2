<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.TutorU.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_photo"
                android:src="@drawable/ic_person_placeholder"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="Foto" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del tutor"
                    android:textSize="15sp"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Materia · Hoy 14:00 – 15:00"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmada"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_pill_blue"
                android:textColor="@color/primary" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvModalidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presencial · Biblioteca, 2.º piso"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            style="@style/Widget.TutorU.ButtonAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sí se dio la tutoría"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/filaAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportar"
                style="@style/Widget.TutorU.ButtonSmallDanger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Reportar inasistencia"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.TutorU.ButtonSmallDanger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

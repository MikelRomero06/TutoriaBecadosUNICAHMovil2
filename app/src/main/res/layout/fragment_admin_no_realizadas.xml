<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTENEDOR PRINCIPAL SUPERIOR (Filtros, Resumen y Scroll de tarjetas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Barra superior con botón Volver y Título -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Tu.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Tutorías no realizadas"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Barra de filtros horizontales -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTodas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:text="Todas"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTutor"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:text="Tutor"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEstudiante"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:text="Estudiante"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnInasistencias"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Inasist."
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Tarjeta de resumen de periodo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_linear_border"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPeriodTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 en el periodo"
                android:textColor="@color/background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPeriodBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tutor 6 · Estudiante 7 · Inasistencias 4 · Sin confirmar 1"
                android:textColor="#CCD6F0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Contenido de las tarjetas con Scroll vertical -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="12dp">

                <!-- TARJETA 1 -->
                <LinearLayout
                    android:id="@+id/cardNotDone1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvWhen1"
                        style="@style/Tu.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vie 30/10 14:00 · Cálculo I"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/badgeType1"
                            style="@style/Tu.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_red"
                            android:text="CANCELADA POR EL TUTOR"
                            android:textColor="@color/tu_red" />

                        <TextView
                            android:id="@+id/badgeUnreviewed1"
                            style="@style/Tu.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_amber"
                            android:text="sin revisar"
                            android:textColor="@color/tu_amber_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPeople1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tutor: Denis Zuniga → Estudiante: Juan Pérez"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Tu.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Motivo para Bienestar:"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReasonAdmin1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&quot;Tengo un evento académico obligatorio&quot;"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Tu.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Motivo para el estudiante:"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReasonStudent1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&quot;Me surgió un evento de la U. ¿Lo pasamos al lunes?&quot;"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />

                    <!-- Botones de la tarjeta 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarcarRevisado"
                            style="@style/Tu.Button"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Marcar revisado"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCitar"
                            style="@style/Tu.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Citar a Denis"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TARJETA 2 -->
                <LinearLayout
                    android:id="@+id/cardNotDone2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvWhen2"
                        style="@style/Tu.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mié 28/10 10:00 · Álgebra"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/badgeType2"
                        style="@style/Tu.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge_red"
                        android:text="CANCELADA POR EL ESTUDIANTE"
                        android:textColor="@color/tu_red" />

                    <TextView
                        android:id="@+id/tvPeople2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Estudiante: Allan Galindo → Tutor: Luis Pérez"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Tu.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Categoría: Enfermedad"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReason2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&quot;Estoy enfermo, no puedo asistir&quot;"
                        android:textColor="@color/tu_text"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkReviewed2"
                            style="@style/Tu.Button"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Marcar revisado"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSummon2"
                            style="@style/Tu.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_linear_border"
                            android:text="Citar a la estudiante"
                            android:textAlignment="center"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- BARRA DE NAVEGACIÓN INFERIOR DE ADMINISTRADOR (Fija en la parte inferior) -->
    <LinearLayout
        android:id="@+id/bottomNavAdmin"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Pestaña 1: Inicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAdminInicio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Inicio"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/inicio" />

        </LinearLayout>

        <!-- Pestaña 2: No realizadas (Activa en esta vista) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavNoRealizadas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="No realizadas"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/mistutoriasazul" />

        </LinearLayout>

        <!-- Pestaña 3: Aprobaciones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavAprobaciones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Aprobaciones"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/perfil" />

        </LinearLayout>

        <!-- Pestaña 4: Bitácora -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNavBitacora"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Bitácora"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/perfil" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>